ROOTGUARD_UPDATER_IMAGE=ghcr.io/foxly-it/rootguard-updater:1.0.16@sha256:4531c5802447170cfb1b7f86bf7eba04891fd9faa0a37c1276a76187d4922516
ROOTGUARD_UNBOUND_IMAGE=ghcr.io/foxly-it/rootguard-unbound:1.0.16@sha256:f79dbe89d266c8697e469b1139b6a68e4e2516536e577c25af6ffbdd2a7aa4bd
ROOTGUARD_ADGUARD_IMAGE=adguard/adguardhome:v1.0.0@sha256:f00a586f0d1caa74f149340bfb225014960310488ffa838406b89256900a96c2
# Beta channel on v1.0.0 until AdGuard publishes a beta newer than it, see
