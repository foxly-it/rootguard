# Bootstrap pin (no real release has cut this component yet) - see
# compose.release.yaml's identical comment on its docker-proxy service.
# No self-update channel yet either, so unlike the other pins in this
# file there is no matching ROOTGUARD_DOCKER_PROXY_UPDATE_IMAGE.
ROOTGUARD_DOCKER_PROXY_IMAGE=ghcr.io/foxly-it/rootguard-docker-proxy:1.0.9@sha256:cd23637173dbf711d0c08364de2da1f68f4c6950c51376b62c50ef87ee03bf98

# The update targets intentionally start on the same immutable release.
# A newer tested release must update these values explicitly.
ROOTGUARD_CORE_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-core:1.0.9@sha256:683dd7352a67e9138e09b33db267db9ec19af74fdf49d69e34213d2abea9e159
ROOTGUARD_WEBAPP_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-webapp:1.0.9@sha256:22f6beaa2c83ea45fe5a55da8884720d1a7bc8a260a8df5b2bd18c8baae9d2a8
ROOTGUARD_UNBOUND_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-unbound:1.0.9@sha256:f03a33908c0e8859cab59fe55db658d8bacdba036e43b4b03992e0f058000535
ROOTGUARD_ADGUARD_UPDATE_IMAGE=adguard/adguardhome:v0.107.79@sha256:aba9e3bf0613be3ba3755e1fc311b126e2c24bec25e18b6483894a88283074f0
# Found in review: Blockpage had no update target at all before - see
# compose.release.yaml's identical comment on this line.
ROOTGUARD_BLOCKPAGE_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-blockpage:1.0.9@sha256:f54d934adf95ce56ca8b06210640ed5005fd71d34a84f891ec68bf23073c91ef

# Found in review: this comment claimed both values below stay an
# unpinned :latest fallback, but they're actually digest-pinned right
# here like every other value in this file - stale ever since the
# attestation proxy joined self-update management digest-pinned from
# the start. Core resolves Core/WebApp/Unbound/Blockpage/the Updater/the
# attestation proxy's own live release automatically via the GitHub
# Releases API; these two are simply refreshed the same way as every
# value above, just documented separately because they were added later.
ROOTGUARD_UPDATER_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-updater:1.0.9@sha256:c539b4db304254251d1211c04c95378017d69d3e23d42ad4b79a34c32e5c7008
ROOTGUARD_ATTESTATION_PROXY_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-attestation-proxy:1.0.9@sha256:7bbfd5fe4f49adc31fc9635dad1b5ab30a79c05e3e00d6ec04deca4ca4bbe6a0

# Replace all secret values before starting the stack.
ROOTGUARD_API_TOKEN=replace-with-a-long-random-token
ROOTGUARD_ADMIN_USER=admin
ROOTGUARD_ADMIN_PASSWORD=replace-with-a-strong-password
ROOTGUARD_RECOVERY_TOKEN=replace-with-a-separate-long-random-recovery-key

ROOTGUARD_WEB_BIND=0.0.0.0
ROOTGUARD_WEB_PORT=8080

# Only needed for a rootless Docker daemon (install.sh sets this
# automatically when it detects one) - the host path to bind-mount as
# docker-proxy's real socket. Leave unset for a normal (rootful) Docker
# installation. See docs/rootless-docker.md before using rootless Docker
# with RootGuard - the default rootless networking driver silently drops
# the real client IP on DNS queries, breaking AdGuard's per-client
# filtering; the `pasta` driver is required instead.
# ROOTGUARD_DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
