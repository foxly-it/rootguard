# RootGuard 1.0.0
# Verified multi-architecture manifests. Keep the tag for readability and the
# digest for immutability. Change these only as a complete tested release set.
ROOTGUARD_CORE_IMAGE=ghcr.io/foxly-it/rootguard-core:1.0.17@sha256:a114ea933307394b640fd3df992b5e786112e92b67dd0ae40667ccde35c96525
ROOTGUARD_WEBAPP_IMAGE=ghcr.io/foxly-it/rootguard-webapp:1.0.17@sha256:c1f8167484073a8e5f442aaf204ea23eca6b9b2a60823751272bfa13755a039a
ROOTGUARD_UPDATER_IMAGE=ghcr.io/foxly-it/rootguard-updater:1.0.17@sha256:2bce404649e06fce863a2f5b3ef226c0dd0f22900ec23d2da5190492cc2bbe03
ROOTGUARD_UNBOUND_IMAGE=ghcr.io/foxly-it/rootguard-unbound:1.0.17@sha256:a2f83ffb77d1b6353a07a54516425825b2016640cd5075d9ed16a1936393f0d7
ROOTGUARD_ADGUARD_IMAGE=adguard/adguardhome:v1.0.0@sha256:f00a586f0d1caa74f149340bfb225014960310488ffa838406b89256900a96c2
# Beta channel on v1.0.0 until AdGuard publishes a beta newer than it, see
# compose.release.yaml.
ROOTGUARD_ADGUARD_BETA_IMAGE=adguard/adguardhome:v1.0.0@sha256:f00a586f0d1caa74f149340bfb225014960310488ffa838406b89256900a96c2
ROOTGUARD_BLOCKPAGE_IMAGE=ghcr.io/foxly-it/rootguard-blockpage:1.0.17@sha256:a5bc39f4f1bee50e42e43547a9ae8eaeec5556a0d2e1eb4155eac4c159f52790
ROOTGUARD_ATTESTATION_PROXY_IMAGE=ghcr.io/foxly-it/rootguard-attestation-proxy:1.0.17@sha256:f4d5752b6a67b305536e0fed193f93d1374005c2c281759162c73d2ba6f0a94a
# Bootstrap pin (no real release has cut this component yet) - see
# compose.release.yaml's identical comment on its docker-proxy service.
# No self-update channel yet either, so unlike the other pins in this
# file there is no matching ROOTGUARD_DOCKER_PROXY_UPDATE_IMAGE.
ROOTGUARD_DOCKER_PROXY_IMAGE=ghcr.io/foxly-it/rootguard-docker-proxy:1.0.17@sha256:f65ad675b12de5e6ba8f9f6bdd2b0d5a765eb1d504aeeeb11c8005f360775f28

# The update targets intentionally start on the same immutable release.
# A newer tested release must update these values explicitly.
ROOTGUARD_CORE_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-core:1.0.17@sha256:a114ea933307394b640fd3df992b5e786112e92b67dd0ae40667ccde35c96525
ROOTGUARD_WEBAPP_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-webapp:1.0.17@sha256:c1f8167484073a8e5f442aaf204ea23eca6b9b2a60823751272bfa13755a039a
ROOTGUARD_UNBOUND_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-unbound:1.0.17@sha256:a2f83ffb77d1b6353a07a54516425825b2016640cd5075d9ed16a1936393f0d7
ROOTGUARD_ADGUARD_UPDATE_IMAGE=adguard/adguardhome:v1.0.0@sha256:f00a586f0d1caa74f149340bfb225014960310488ffa838406b89256900a96c2
# Found in review: Blockpage had no update target at all before - see
# compose.release.yaml's identical comment on this line.
ROOTGUARD_BLOCKPAGE_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-blockpage:1.0.17@sha256:a5bc39f4f1bee50e42e43547a9ae8eaeec5556a0d2e1eb4155eac4c159f52790

# Found in review: this comment claimed both values below stay an
# unpinned :latest fallback, but they're actually digest-pinned right
# here like every other value in this file - stale ever since the
# attestation proxy joined self-update management digest-pinned from
# the start. Core resolves Core/WebApp/Unbound/Blockpage/the Updater/the
# attestation proxy's own live release automatically via the GitHub
# Releases API; these two are simply refreshed the same way as every
# value above, just documented separately because they were added later.
ROOTGUARD_UPDATER_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-updater:1.0.17@sha256:2bce404649e06fce863a2f5b3ef226c0dd0f22900ec23d2da5190492cc2bbe03
ROOTGUARD_ATTESTATION_PROXY_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-attestation-proxy:1.0.17@sha256:f4d5752b6a67b305536e0fed193f93d1374005c2c281759162c73d2ba6f0a94a

# Replace all secret values before starting the stack.
ROOTGUARD_API_TOKEN=replace-with-a-long-random-token
ROOTGUARD_ADMIN_USER=admin
ROOTGUARD_ADMIN_PASSWORD=replace-with-a-strong-password
ROOTGUARD_RECOVERY_TOKEN=replace-with-a-separate-long-random-recovery-key

ROOTGUARD_WEB_BIND=0.0.0.0
ROOTGUARD_WEB_PORT=8080

# Only needed for a rootless Docker daemon (install.sh sets this
# automatically when it detects one) - the host path to bind-mount as
# docker-proxy's real socket. Leave unset for a normal (rootful) Docker
# installation. See docs/rootless-docker.md before using rootless Docker
# with RootGuard - the default rootless networking driver silently drops
# the real client IP on DNS queries, breaking AdGuard's per-client
# filtering; the `pasta` driver is required instead.
# ROOTGUARD_DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
