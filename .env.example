# Copy this file to .env and replace both secrets before starting RootGuard.
ROOTGUARD_API_TOKEN=replace-with-a-long-random-token
ROOTGUARD_ADMIN_USER=admin
ROOTGUARD_ADMIN_PASSWORD=replace-with-a-strong-password
ROOTGUARD_CORE_IMAGE=rootguard-core:dev
ROOTGUARD_WEBAPP_IMAGE=rootguard-webapp:dev
ROOTGUARD_CORE_UPDATE_IMAGE=rootguard-core:dev
ROOTGUARD_WEBAPP_UPDATE_IMAGE=rootguard-webapp:dev

ROOTGUARD_WEB_PORT=8080

# Optional image overrides for development. Stable releases will pin these.
# ROOTGUARD_UNBOUND_IMAGE=ghcr.io/foxly-it/rootguard-unbound:latest
# ROOTGUARD_ADGUARD_IMAGE=adguard/adguardhome:v0.107.78

# Optional, server-controlled update channels. These values are never accepted
# from the browser API.
# ROOTGUARD_UNBOUND_UPDATE_IMAGE=ghcr.io/foxly-it/rootguard-unbound:latest
# ROOTGUARD_ADGUARD_UPDATE_IMAGE=adguard/adguardhome:latest
